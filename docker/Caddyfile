(openmirage_routes) {
  encode gzip zstd

  @api path /auth* /v1* /healthz /readyz /metrics /internal* /__diagnostics*
  @collab_http path /collab/*
  @worker_http path /worker/*

  handle @api {
    reverse_proxy api:4000
  }

  handle /collab {
    reverse_proxy collab:4100
  }

  handle @collab_http {
    uri strip_prefix /collab
    reverse_proxy collab:4100
  }

  handle @worker_http {
    uri strip_prefix /worker
    reverse_proxy worker:4200
  }

  handle {
    reverse_proxy web:80
  }
}

{$CADDY_SITE_ADDRESS:http://localhost}, http://127.0.0.1 {
  import openmirage_routes
}
