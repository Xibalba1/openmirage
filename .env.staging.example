OPENMIRAGE_ENV=staging
CADDY_SITE_ADDRESS=staging.example.com
APP_BASE_URL=https://staging.example.com
OPENMIRAGE_PUBLIC_BASE_URL=https://staging.example.com
OPENMIRAGE_PUBLIC_COLLAB_HTTP_URL=https://staging.example.com/collab
OPENMIRAGE_PUBLIC_COLLAB_WS_URL=wss://staging.example.com/collab
OPENMIRAGE_PUBLIC_WORKER_HTTP_URL=https://staging.example.com/worker
AUTH_PATH=/auth
COLLAB_WS_PATH=/collab
SESSION_COOKIE_NAME=openmirage_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=true
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Default self-hosted staging storage baseline.
# Switch STORAGE_PROVIDER and related values for an external S3-compatible backend.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=openmirage-assets
STORAGE_LOCAL_ROOT=.openmirage/storage
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=openmirage
STORAGE_S3_SECRET_ACCESS_KEY=openmirage123
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
ENABLE_TEST_ERROR_ROUTES=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=0.1.0
