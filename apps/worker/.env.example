STORAGE_S3_SECRET_ACCESS_KEY=openmirage123
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
WORKER_HEARTBEAT_INTERVAL_MS=5000
