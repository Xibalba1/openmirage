{
  "name": "@openmirage/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-service.mjs ./src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --import tsx ./src/*.test.ts && node ../../scripts/check-workspace.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "docker build -f Dockerfile -t openmirage-worker:local ../.."
  },
  "dependencies": {
    "@openmirage/config-env": "workspace:*",
    "@openmirage/db": "workspace:*",
    "@openmirage/observability": "workspace:*",
    "@openmirage/storage": "workspace:*",
    "@openmirage/types": "workspace:*",
    "fastify": "^5.3.2"
  }
}
