{
  "name": "@openmirage/collab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-service.mjs ./src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm --filter @openmirage/db build && node --test --import tsx ./src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "docker build -f Dockerfile -t openmirage-collab:local ../.."
  },
  "dependencies": {
    "@hocuspocus/server": "^3.2.6",
    "@openmirage/auth": "workspace:*",
    "@openmirage/config-env": "workspace:*",
    "@openmirage/db": "workspace:*",
    "@openmirage/observability": "workspace:*",
    "@openmirage/types": "workspace:*",
    "fastify": "^5.3.2",
    "lib0": "^0.2.114",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  }
}
