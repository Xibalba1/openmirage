OPENMIRAGE_ENV=development
SERVICE_HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=0.1.0
API_PORT=4000
APP_BASE_URL=http://localhost
AUTH_PATH=/auth
SESSION_COOKIE_NAME=openmirage_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
DEV_AUTH_EXPOSE_MAGIC_LINK=true
SMOKE_TEST_SHARED_SECRET=openmirage-smoke-secret
DATABASE_URL=postgres://openmirage:openmirage@postgres:5432/openmirage
STORAGE_PROVIDER=minio
STORAGE_BUCKET=openmirage-assets
STORAGE_LOCAL_ROOT=.openmirage/storage
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=openmirage
STORAGE_S3_SECRET_ACCESS_KEY=openmirage123
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
ENABLE_TEST_ERROR_ROUTES=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=0.1.0
