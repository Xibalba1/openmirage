{
  "name": "@openmirage/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/noop-task.mjs dev @openmirage/db",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --import tsx ./src/*.test.ts",
    "test:coverage": "pnpm build && mkdir -p coverage && node --experimental-test-coverage --test ./dist/*.test.js > coverage/node-test-coverage.txt 2>&1; status=$?; cat coverage/node-test-coverage.txt; if [ $status -ne 0 ]; then exit $status; fi; node ../../scripts/check-changed-coverage.mjs --format node-test-coverage --report-file coverage/node-test-coverage.txt src/index.ts src/metadata.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "node ../../scripts/noop-task.mjs docker:build @openmirage/db",
    "migrate:create": "node ./scripts/create-migration.mjs",
    "migrate:up": "node ./scripts/migrate-up.mjs",
    "migrate:status": "node ./scripts/migrate-status.mjs",
    "reset": "node ./scripts/reset.mjs",
    "seed": "node --import tsx ./scripts/seed.mjs"
  },
  "dependencies": {
    "@openmirage/types": "workspace:*",
    "pg": "^8.13.1",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "node-pg-migrate": "^7.9.1"
  }
}
