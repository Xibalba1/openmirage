{
  "name": "@openmirage/config-env",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/noop-task.mjs dev @openmirage/config-env",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../../scripts/check-workspace.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "node ../../scripts/noop-task.mjs docker:build @openmirage/config-env"
  },
  "dependencies": {
    "@openmirage/types": "workspace:*"
  }
}
