{
  "name": "@openmirage/auth",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/noop-task.mjs dev @openmirage/auth",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --import tsx ./src/index.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "node ../../scripts/noop-task.mjs docker:build @openmirage/auth"
  },
  "dependencies": {
    "@openmirage/config-env": "workspace:*",
    "@openmirage/types": "workspace:*"
  }
}
